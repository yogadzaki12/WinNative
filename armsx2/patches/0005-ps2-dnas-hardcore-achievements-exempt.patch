+// In hardcore mode, only the DNAS auth-bypass groups from a disk patch file are
+// allowed to load (they merely let a game reach its online mode; they are not a
+// gameplay cheat). This keeps the gametitle line and any group whose label
+// contains "DNAS", dropping every other section so no real cheat sneaks in.
+std::string Patch::KeepOnlyDnasBypassGroups(const std::string& pnach_data)
+{
+	std::istringstream ss(pnach_data);
+	std::string line;
+	std::string out;
+	bool in_dnas = false;
+	while (std::getline(ss, line))
+	{
+		const std::string_view trimmed = StringUtil::StripWhitespace(line);
+		if (!trimmed.empty() && trimmed.front() == '[' && trimmed.back() == ']')
+		{
+			const std::string lower = StringUtil::toLower(std::string(trimmed));
+			in_dnas = (lower.find("dnas") != std::string::npos);
+			if (in_dnas)
+			{
+				out.append(line);
+				out.push_back('\n');
+			}
+			continue;
+		}
+		if (StringUtil::StartsWithNoCase(trimmed, "gametitle"))
+		{
+			out.append(line);
+			out.push_back('\n');
+			continue;
+		}
+		if (in_dnas)
+		{
+			out.append(line);
+			out.push_back('\n');
+		}
+	}
+	return out;
+}
