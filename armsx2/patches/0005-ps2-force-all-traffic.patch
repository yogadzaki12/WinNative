@@ -17,6 +17,7 @@
 #endif
 
 #include "TCP_Session.h"
+#include "Config.h"
 
 using namespace PacketReader;
 using namespace PacketReader::IP;
@@ -204,9 +205,25 @@ namespace Sessions
 				errno);
 #endif
 
+		// EthForceAllTraffic: aim the real socket at the configured DNS1 server
+		// (fallback DNS2) instead of the address the game dialed, so ALL PS2 TCP
+		// connections land on an all-in-one revival server. The session keeps
+		// destIP, so packets returned to the PS2 still appear to come from the
+		// address it connected to (see SocketAdapter::recv) and its TCP state
+		// matches. No-op unless enabled and a target IP is configured.
+		IP_Address tcpTarget = destIP;
+		if (EmuConfig.DEV9.EthForceAllTraffic)
+		{
+			IP_Address forceIP = *(IP_Address*)EmuConfig.DEV9.DNS1;
+			if (forceIP.integer == 0)
+				forceIP = *(IP_Address*)EmuConfig.DEV9.DNS2;
+			if (forceIP.integer != 0)
+				tcpTarget = forceIP;
+		}
+
 		sockaddr_in endpoint{};
 		endpoint.sin_family = AF_INET;
-		endpoint.sin_addr = std::bit_cast<in_addr>(destIP);
+		endpoint.sin_addr = std::bit_cast<in_addr>(tcpTarget);
 		endpoint.sin_port = htons(destPort);
 
 		ret = connect(client, reinterpret_cast<const sockaddr*>(&endpoint), sizeof(endpoint));
