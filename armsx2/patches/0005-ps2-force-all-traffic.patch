index 45b4cba..024b419 100644
--- a/pcsx2/Config.h
+++ b/pcsx2/Config.h
@@ -1074,6 +1074,12 @@ struct Pcsx2Config
 		bool EthLogDHCP{false};
 		bool EthLogDNS{false};
 
+		// WinNative: force ALL PS2 TCP/UDP traffic to the configured DNS1 server
+		// (fallback DNS2), not just DNS lookups — for all-in-one revival servers
+		// that answer every request. Replies are presented as coming from the
+		// address the game dialed, so the PS2 stack accepts them transparently.
+		bool EthForceAllTraffic{false};
+
 		bool InterceptDHCP{false};
 		u8 PS2IP[4]{};
 		u8 Mask[4]{};
diff --git a/pcsx2/DEV9/Sessions/TCP_Session/TCP_Session_Out.cpp b/pcsx2/DEV9/Sessions/TCP_Session/TCP_Session_Out.cpp
index bd1d6e5..d50edc6 100644
--- a/pcsx2/DEV9/Sessions/TCP_Session/TCP_Session_Out.cpp
